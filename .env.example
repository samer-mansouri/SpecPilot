# SpecPilot Environment Configuration Example
# Copy this file to .env and replace with your credentials

# LLM Provider Configuration
SPECPILOT_LLM_API_KEY=your_api_key_here
SPECPILOT_LLM_BASE_URL=https://api.openai.com/v1
SPECPILOT_LLM_MODEL=gpt-4o-mini
SPECPILOT_LLM_TIMEOUT=30.0
SPECPILOT_LLM_MAX_STEPS=5
